<!--
  SentinelForge Custom Wazuh Rules
  Rule IDs: 100200 - 100299 (custom range)
  Deployed to: /var/ossec/etc/rules/sentinelforge_rules.xml
-->

<group name="sentinelforge,">

  <!-- ===== HONEYPOT RULES (Module 5: RPi) ===== -->

  <!-- Any connection to the honeypot agent is suspicious -->
  <rule id="100200" level="12">
    <if_group>syslog</if_group>
    <match>rpi-honeypot</match>
    <description>Honeypot: Connection detected on honeypot agent</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>honeypot,sentinelforge,</group>
  </rule>

  <!-- Cowrie: SSH login attempt on honeypot -->
  <rule id="100201" level="14">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.success|cowrie.login.failed</field>
    <description>Honeypot: SSH login attempt detected (Cowrie)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>honeypot,brute_force,sentinelforge,</group>
  </rule>

  <!-- Cowrie: Attacker executed commands after login -->
  <rule id="100202" level="15">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.command.input</field>
    <description>Honeypot: Attacker executed commands after honeypot login</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>honeypot,execution,sentinelforge,</group>
  </rule>

  <!-- Cowrie: File download attempt on honeypot -->
  <rule id="100203" level="15">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.file_download</field>
    <description>Honeypot: Attacker attempted file download on honeypot</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>honeypot,malware,sentinelforge,</group>
  </rule>

  <!-- ===== SSH BRUTE FORCE RULES ===== -->

  <!-- Aggressive brute force: 10+ failures in 60s from same IP -->
  <rule id="100210" level="13" frequency="10" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH: Aggressive brute force (10+ failures in 60s) from same IP</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>brute_force,authentication_failures,sentinelforge,</group>
  </rule>

  <!-- Distributed brute force: 5+ SSH failures in 120s (no same_source_ip
       constraint → fires when different IPs contribute). Wazuh doesn't
       support a <different_source_ip/> element; the absence of a grouping
       constraint yields the same effect. -->
  <rule id="100211" level="12" frequency="5" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <description>SSH: Distributed brute force (5+ failures in 120s, multiple sources)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>brute_force,authentication_failures,sentinelforge,</group>
  </rule>

  <!-- ===== SUSPICIOUS COMMAND EXECUTION ===== -->

  <!-- wget/curl to external host -->
  <rule id="100220" level="10">
    <if_group>syslog</if_group>
    <match>wget |curl </match>
    <regex>https?://\S+</regex>
    <description>Suspicious: wget/curl downloading from external URL</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>execution,sentinelforge,</group>
  </rule>

  <!-- chmod +x on downloaded file -->
  <rule id="100221" level="12">
    <if_sid>100220</if_sid>
    <match>chmod +x|chmod 755|chmod 777</match>
    <description>Suspicious: Downloaded file made executable</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>execution,sentinelforge,</group>
  </rule>

  <!-- ===== PRIVILEGE ESCALATION ===== -->

  <!-- Repeated sudo failures -->
  <rule id="100230" level="11" frequency="3" timeframe="120">
    <if_matched_sid>5401</if_matched_sid>
    <same_source_ip />
    <description>Privilege Escalation: Repeated sudo failures (3+ in 120s)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,sentinelforge,</group>
  </rule>

  <!-- su attempt to root -->
  <rule id="100231" level="10">
    <if_group>syslog</if_group>
    <match>su: FAILED SU</match>
    <description>Privilege Escalation: Failed su attempt</description>
    <mitre>
      <id>T1548</id>
    </mitre>
    <group>privilege_escalation,sentinelforge,</group>
  </rule>

  <!-- ===== FILE INTEGRITY ===== -->

  <!-- Critical config file changes -->
  <rule id="100240" level="12">
    <if_sid>550</if_sid>
    <match>/etc/ssh/sshd_config|/etc/passwd|/etc/shadow|/etc/sudoers</match>
    <description>File Integrity: Critical system config file modified</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>file_integrity,sentinelforge,</group>
  </rule>

  <!-- New executable in /tmp -->
  <rule id="100241" level="10">
    <if_sid>554</if_sid>
    <match>/tmp/</match>
    <description>File Integrity: New file created in /tmp directory</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>file_integrity,sentinelforge,</group>
  </rule>

  <!-- ===== RECONNAISSANCE ===== -->

  <!-- Port scan: many connection attempts from one IP in a short window -->
  <rule id="100250" level="10" frequency="20" timeframe="60">
    <if_matched_sid>5706</if_matched_sid>
    <same_source_ip />
    <description>Recon: Port scan suspected (20+ probes in 60s from same IP)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,sentinelforge,</group>
  </rule>

  <!-- Recon tool signatures in user-agent or command line -->
  <rule id="100251" level="10">
    <if_group>syslog</if_group>
    <regex>nmap |masscan |zmap |nikto |dirb |gobuster |wpscan </regex>
    <description>Recon: Known scanning tool invocation detected</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>recon,sentinelforge,</group>
  </rule>

  <!-- ===== INITIAL ACCESS ===== -->

  <!-- Web shell pattern: common PHP/JSP backdoor hash -->
  <rule id="100252" level="14">
    <if_sid>554</if_sid>
    <regex>\.(php|phtml|jsp|aspx)$</regex>
    <match>/var/www/|/srv/www/|/usr/share/nginx/html/</match>
    <description>Initial Access: Possible web shell uploaded to web root</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>initial_access,web_attack,sentinelforge,</group>
  </rule>

  <!-- Successful SSH login from external (public) IP -->
  <rule id="100253" level="10">
    <if_sid>5715</if_sid>
    <regex>from (?!10\.|172\.(1[6-9]|2\d|3[01])\.|192\.168\.|127\.)</regex>
    <description>Initial Access: Successful SSH login from external IP</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>initial_access,authentication_success,sentinelforge,</group>
  </rule>

  <!-- ===== PERSISTENCE ===== -->

  <!-- New cron job added -->
  <rule id="100254" level="12">
    <if_sid>550</if_sid>
    <match>/etc/cron.d/|/etc/crontab|/var/spool/cron/</match>
    <description>Persistence: New/modified cron job detected</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>persistence,sentinelforge,</group>
  </rule>

  <!-- SSH authorized_keys modified -->
  <rule id="100255" level="13">
    <if_sid>550</if_sid>
    <match>/.ssh/authorized_keys</match>
    <description>Persistence: SSH authorized_keys file modified</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
    <group>persistence,sentinelforge,</group>
  </rule>

  <!-- New user account created -->
  <rule id="100256" level="11">
    <if_group>syslog</if_group>
    <match>new user:|useradd[</match>
    <description>Persistence: New user account created</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>persistence,sentinelforge,</group>
  </rule>

  <!-- Systemd service added / modified -->
  <rule id="100257" level="11">
    <if_sid>550</if_sid>
    <match>/etc/systemd/system/|/lib/systemd/system/</match>
    <description>Persistence: systemd service unit created or modified</description>
    <mitre>
      <id>T1543.002</id>
    </mitre>
    <group>persistence,sentinelforge,</group>
  </rule>

  <!-- ===== DEFENSE EVASION ===== -->

  <!-- Wazuh agent stopped or restarted unexpectedly -->
  <rule id="100260" level="13">
    <if_group>syslog</if_group>
    <regex>wazuh-agentd.*(stopped|killed|terminated)</regex>
    <description>Defense Evasion: Wazuh agent stopped — possible tampering</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,sentinelforge,</group>
  </rule>

  <!-- Log file cleared / truncated -->
  <rule id="100261" level="13">
    <if_group>syslog</if_group>
    <regex>&gt; /var/log/|: /var/log/\S+ (truncated|cleared)</regex>
    <description>Defense Evasion: System log file cleared or truncated</description>
    <mitre>
      <id>T1070.002</id>
    </mitre>
    <group>defense_evasion,sentinelforge,</group>
  </rule>

  <!-- Firewall rules flushed -->
  <rule id="100262" level="13">
    <if_group>syslog</if_group>
    <regex>iptables -F|iptables --flush|ufw disable|systemctl stop firewalld</regex>
    <description>Defense Evasion: Host firewall disabled or rules flushed</description>
    <mitre>
      <id>T1562.004</id>
    </mitre>
    <group>defense_evasion,sentinelforge,</group>
  </rule>

  <!-- Bash history cleared -->
  <rule id="100263" level="11">
    <if_group>syslog</if_group>
    <regex>history -c|&gt; ~/.bash_history|rm .*\.bash_history</regex>
    <description>Defense Evasion: Shell history cleared</description>
    <mitre>
      <id>T1070.003</id>
    </mitre>
    <group>defense_evasion,sentinelforge,</group>
  </rule>

  <!-- ===== CREDENTIAL ACCESS ===== -->

  <!-- /etc/shadow read -->
  <rule id="100270" level="13">
    <if_group>syslog</if_group>
    <regex>(cat|less|more|head|tail|grep) .*/etc/shadow</regex>
    <description>Credential Access: /etc/shadow read attempt</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>credential_access,sentinelforge,</group>
  </rule>

  <!-- ===== COMMAND AND CONTROL ===== -->

  <!-- Reverse shell spawn pattern -->
  <rule id="100280" level="15">
    <if_group>syslog</if_group>
    <regex>bash -i &gt;&amp;? /dev/tcp/|nc -[el]*e .*/bin/(ba)?sh|python -c 'import socket</regex>
    <description>C2: Reverse shell command pattern detected</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>command_and_control,sentinelforge,</group>
  </rule>

  <!-- Base64-encoded command execution (often used to hide payloads) -->
  <rule id="100281" level="12">
    <if_group>syslog</if_group>
    <regex>(bash|sh) .*-c .*base64 -d|echo [A-Za-z0-9+/]{40,}=* \| base64 -d</regex>
    <description>C2: Base64-encoded command execution — obfuscation suspected</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>command_and_control,defense_evasion,sentinelforge,</group>
  </rule>

  <!-- ===== IMPACT ===== -->

  <!-- Cryptominer process signatures -->
  <rule id="100290" level="14">
    <if_group>syslog</if_group>
    <regex>xmrig|minerd|cpuminer|coinhive|cryptonight|stratum\+tcp</regex>
    <description>Impact: Cryptocurrency miner process detected</description>
    <mitre>
      <id>T1496</id>
    </mitre>
    <group>impact,malware,sentinelforge,</group>
  </rule>

  <!-- Mass file deletion / destructive command -->
  <rule id="100291" level="15">
    <if_group>syslog</if_group>
    <regex>rm -rf / |dd if=/dev/(zero|random) of=/dev/[sh]d|mkfs\.</regex>
    <description>Impact: Destructive command detected (mass delete / disk wipe)</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>impact,sentinelforge,</group>
  </rule>

</group>
